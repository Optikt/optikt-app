{
	"name": "optikt-app",
	"private": true,
	"version": "0.29.4",
	"type": "module",
	"packageManager": "pnpm@11.24.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "f() { prettier --write \"${1:-.}\"; }; f",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest --run --project=server --project=client",
		"test:integration": "node scripts/run-integration-tests.mjs",
		"test:coverage": "node scripts/run-coverage.mjs",
		"test": "pnpm run test:unit && pnpm run test:e2e",
		"test:e2e": "node scripts/run-e2e-tests.mjs",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:bootstrap": "node scripts/bootstrap.js",
		"svelte:doctor": "svelte-doctor check",
		"check:unused": "lilmolly",
		"knip": "DATABASE_URL=postgresql://dummy knip"
	},
	"devDependencies": {
		"@eslint/compat": "latest",
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.47.0",
		"@oslojs/encoding": "^1.1.0",
		"@playwright/test": "^1.63.0",
		"@sparticuz/chromium": "^153.0.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@testcontainers/postgresql": "^12.1.0",
		"@types/node": "^22",
		"@vitest/browser-playwright": "^5.0.1",
		"@vitest/coverage-v8": "^5.0.1",
		"bits-ui": "^2.19.2",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"knip": "^6.37.0",
		"layerchart": "2.5.0",
		"lilmolly": "^1.3.7",
		"open-codebase-index": "^0.31.0",
		"playwright": "^1.63.0",
		"prettier": "^3.9.8",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"svelte-doctor": "^0.4.0",
		"tailwind-scrollbar": "^4.0.2",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.13",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0",
		"vite": "^8.3.0",
		"vitest": "^5.0.1",
		"vitest-browser-svelte": "^3.1.0"
	},
	"dependencies": {
		"@formkit/auto-animate": "^0.10.0",
		"@node-rs/argon2": "^2.2.1",
		"@pdfslick/core": "4.0.0",
		"clsx": "^2.1.1",
		"date-fns": "^4.4.0",
		"drizzle-orm": "^0.45.2",
		"export-to-csv": "^1.5.0",
		"libphonenumber-js": "^1.13.13",
		"pdfjs-dist": "6.0.227",
		"postgres": "^3.4.9",
		"puppeteer-core": "^25.11.0",
		"svelecte": "^5.3.0",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.7.0",
		"zod": "^4.6.5"
	}
}
