{
	"name": "optikt-app",
	"private": true,
	"version": "0.21.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "f() { prettier --write \"${1:-.}\"; }; f",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest --run",
		"test": "pnpm run test:unit && pnpm run test:e2e",
		"test:e2e": "playwright test",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:bootstrap": "node scripts/bootstrap.js",
		"svelte:doctor": "svelte-doctor check",
		"check:unused": "lilmolly",
		"knip": "DATABASE_URL=postgresql://dummy knip"
	},
	"devDependencies": {
		"@eslint/compat": "latest",
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.3",
		"@lucide/svelte": "^1.37.0",
		"@oslojs/encoding": "^1.1.0",
		"@playwright/test": "^1.62.1",
		"@sparticuz/chromium": "^149.0.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^22",
		"@vitest/browser-playwright": "^4.1.11",
		"bits-ui": "^2.19.0",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"knip": "^6.33.0",
		"lilmolly": "^1.3.7",
		"open-codebase-index": "^0.25.1",
		"playwright": "^1.62.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"svelte-doctor": "^0.3.7",
		"tailwind-scrollbar": "^4.0.2",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.12",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.68.0",
		"vite": "^8.2.2",
		"vitest": "^4.1.11",
		"vitest-browser-svelte": "^3.0.0"
	},
	"dependencies": {
		"@formkit/auto-animate": "^0.10.0",
		"@node-rs/argon2": "^2.2.0",
		"@pdfslick/core": "4.0.0",
		"clsx": "^2.1.1",
		"date-fns": "^4.4.0",
		"drizzle-orm": "^0.45.2",
		"export-to-csv": "^1.5.0",
		"libphonenumber-js": "^1.13.12",
		"pdfjs-dist": "6.0.227",
		"postgres": "^3.4.9",
		"puppeteer-core": "^25.9.0",
		"svelecte": "^5.3.0",
