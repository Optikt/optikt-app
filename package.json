{
	"name": "optikt-app",
	"private": true,
	"version": "0.17.14",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "f() { prettier --write \"${1:-.}\"; }; f",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest --run",
		"test": "pnpm run test:unit && pnpm run test:e2e",
		"test:e2e": "playwright test",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:bootstrap": "node scripts/bootstrap.js",
		"svelte:doctor": "svelte-doctor check",
		"check:unused": "lilmolly",
		"knip": "DATABASE_URL=postgresql://dummy knip"
	},
	"devDependencies": {
		"@eslint/compat": "latest",
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.2",
		"@lucide/svelte": "^0.577.0",
		"@oslojs/crypto": "^1.0.1",
		"@oslojs/encoding": "^1.1.0",
		"@playwright/test": "^1.61.1",
		"@sparticuz/chromium": "^149.0.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.69.2",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.2",
		"@types/node": "^22",
		"@vitest/browser-playwright": "^4.1.10",
		"bits-ui": "^2.18.1",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.7.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.20.0",
		"globals": "^17.7.0",
		"knip": "^6.27.0",
		"lilmolly": "^1.3.7",
		"playwright": "^1.61.1",
		"prettier": "^3.9.5",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.4",
		"svelte-check": "^4.7.2",
		"svelte-doctor": "^0.3.1",
		"tailwind-scrollbar": "^4.0.2",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.3.2",
		"tsx": "^4.23.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.63.0",
		"vite": "^8.1.4",
		"vitest": "^4.1.10",
		"vitest-browser-svelte": "^3.0.0"
	},
	"dependencies": {
		"@formkit/auto-animate": "^0.10.0",
		"@node-rs/argon2": "^2.0.2",
		"@pdfslick/core": "^4.0.0",
		"clsx": "^2.1.1",
		"date-fns": "^4.4.0",
		"drizzle-orm": "^0.45.2",
		"export-to-csv": "^1.4.0",
		"libphonenumber-js": "^1.13.8",
		"pdfjs-dist": "^6.0.227",
		"postgres": "^3.4.9",
		"puppeteer-core": "^25.3.0",
		"svelecte": "^5.3.0",
		"svelte-sonner": "^1.1.1",
